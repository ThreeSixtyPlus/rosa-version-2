<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>About | Rosa Rose Design (about page mockup)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&family=Marcellus&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#FDFBF8; --alt:#F8F3EE; --card:#FFFFFF; --text:#1D1A19; --muted:#5E5651; --line:#E9DED3;
  --accent:#6F5D52; --light:#E4D3C7; --ink:#6F5D52;
  --serif:"Marcellus",Georgia,"Times New Roman",serif;
  --sans:"Jost","Helvetica Neue",Arial,sans-serif;
  --hh:94px;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:calc(var(--hh) + 12px);-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--text);font:400 17px/1.65 var(--sans);-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{display:block;max-width:100%}
a{color:inherit}
h1,h2,h3,h4{font-family:var(--serif);font-weight:400;line-height:1.12;margin:0}
h2{font-size:clamp(2rem,4.4vw,3.3rem)}
h3{font-size:clamp(1.45rem,2.4vw,2rem)}
p{margin:0 0 1em}
.wrap{width:min(1240px,92vw);margin-inline:auto}
section{padding:clamp(70px,9vw,130px) 0}
.lede{font-size:1.15rem;color:var(--muted);max-width:58ch}
.small{font-size:.9rem;color:var(--muted)}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px}

/* buttons */
.btn{position:relative;overflow:hidden;isolation:isolate;display:inline-flex;align-items:center;justify-content:center;gap:.6em;padding:.82em 1.55em;border-radius:999px;border:1px solid transparent;font:400 .9rem/1 var(--sans);letter-spacing:.04em;text-decoration:none;cursor:pointer;transition:color .4s,border-color .4s}
.btn::before{content:"";position:absolute;inset:0;background:var(--hov,#54463D);transform:translateY(101%);transition:transform .5s cubic-bezier(.2,.7,.2,1);z-index:-1}
.btn:hover::before,.btn:focus-visible::before{transform:none}
.btn:hover,.btn:focus-visible{color:var(--hov-text,#fff)}
.btn-dark{background:var(--ink);color:#FDFBF8}
.btn-line{background:transparent;border-color:var(--ink);color:var(--ink);--hov:var(--ink)}
.btn-cream{background:#F7F1EB;color:var(--ink);--hov:var(--ink)}
.btn-ghost-light{background:transparent;border-color:rgba(255,255,255,.8);color:#fff;--hov:#F7F1EB;--hov-text:var(--ink)}
.btn-row{display:flex;flex-wrap:wrap;gap:14px;align-items:center}

/* header */
.site-header{position:sticky;top:0;z-index:50;background:var(--alt);color:var(--text);box-shadow:0 1px 0 var(--line);transition:background .4s,color .4s,box-shadow .4s}
.header-in{display:flex;align-items:center;justify-content:space-between;gap:24px;height:var(--hh)}
.brand{display:flex;align-items:center;gap:16px;text-decoration:none}
.badge{width:88px;height:88px;border-radius:50%;overflow:hidden;flex:none;background:#F0E7DF;box-shadow:0 0 0 1px rgba(0,0,0,.06)}
.badge img{width:100%;height:100%;object-fit:cover;transform:scale(1.07)}
.wm{display:flex;flex-direction:column;gap:7px;line-height:1}
.wm b{font:400 clamp(1.2rem,1.9vw,1.7rem)/1 var(--serif);text-transform:uppercase;letter-spacing:.34em;white-space:nowrap}
.wm i{font:400 .68rem/1 var(--sans);font-style:normal;text-transform:uppercase;letter-spacing:.5em;color:var(--muted);white-space:nowrap}
.nav{display:flex;align-items:center;gap:4px}
.nav a.link{padding:10px 14px;text-decoration:none;position:relative}
.nav a.link::after{content:"";position:absolute;left:14px;right:14px;bottom:4px;height:1px;background:currentColor;transform:scaleX(0);transform-origin:left;transition:transform .4s}
.nav a.link:hover::after,.nav a.link[aria-current="page"]::after{transform:scaleX(1)}
.nav .btn{margin-left:12px;padding:.72em 1.3em}
.menu-btn{display:none;background:none;border:1px solid currentColor;border-radius:999px;padding:.65em 1.1em;color:inherit;font:400 .92rem var(--sans);cursor:pointer}

/* hero: split layout, image fully visible, text beside it on cream */
.hero{display:grid;grid-template-columns:minmax(340px,.82fr) 1.18fr;min-height:calc(100svh - var(--hh));background:var(--bg);color:var(--text);overflow:hidden}
.hero.short{min-height:74svh}
.hero-body{display:flex;flex-direction:column;justify-content:center;padding:clamp(40px,6vw,100px) clamp(24px,5vw,84px)}
.hero-media{position:relative;overflow:hidden;min-height:440px;background:var(--light)}
.hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;animation:kb 16s cubic-bezier(.2,.6,.2,1) both}
@keyframes kb{from{transform:scale(1.12)}to{transform:scale(1)}}
.hero h1{font-size:clamp(2.6rem,5vw,4.9rem);line-height:1.04;max-width:12ch}
.w{display:inline-block;overflow:hidden;vertical-align:top;padding-bottom:.12em;margin-bottom:-.12em}
.w>span{display:inline-block;animation:rise 1.1s cubic-bezier(.2,.7,.2,1) both;animation-delay:calc(var(--d,0) * 120ms + 300ms)}
@keyframes rise{from{transform:translateY(110%)}to{transform:none}}
.rolling{height:1.35em;overflow:hidden;font:400 clamp(1.25rem,2.2vw,1.8rem)/1.35 var(--serif);color:var(--accent);margin:18px 0 30px}
.rolling ul{list-style:none;margin:0;padding:0}
.rolling li{height:1.35em;white-space:nowrap}
.hero .btn-row{animation:fadeup 1s 1.1s both}
@keyframes fadeup{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}

/* image reveal + parallax */
.frame{position:relative;overflow:hidden;border-radius:2px;background:var(--light)}
.frame img{width:100%;height:100%;object-fit:cover;transition:transform 1.4s cubic-bezier(.2,.7,.2,1)}
/* the wipe runs on the image, not the frame, so the scroll trigger can see the frame */
.anim .clip{background:transparent}
.anim .clip img{clip-path:inset(100% 0 0 0);transform:scale(1.18)}
.anim .clip.in img{clip-path:inset(0 0 0 0);transform:scale(1);transition:clip-path 1.3s cubic-bezier(.7,0,.2,1),transform 1.4s cubic-bezier(.2,.7,.2,1)}
.zoom:hover img{transform:scale(1.06)}
.reveal{transition:opacity 1s cubic-bezier(.2,.7,.2,1),transform 1s cubic-bezier(.2,.7,.2,1)}
.anim .reveal{opacity:0;transform:translateY(26px)}
.anim .reveal.in{opacity:1;transform:none}
[data-speed]{will-change:transform}
main{overflow-x:clip}

/* filmstrip of project photos */
.strip{overflow:hidden;padding:8px 0}
.strip-track{display:flex;gap:16px;width:max-content;animation:film 70s linear infinite}
.strip:hover .strip-track{animation-play-state:paused}
.strip figure{margin:0;width:clamp(240px,24vw,340px);height:clamp(240px,24vw,340px);position:relative;overflow:hidden;border-radius:2px;flex:none}
.strip img{width:100%;height:100%;object-fit:cover;transition:transform 1.2s cubic-bezier(.2,.7,.2,1)}
.strip figure:hover img{transform:scale(1.07)}
.strip figcaption{position:absolute;left:12px;bottom:12px;padding:8px 16px;color:var(--text);font:400 1rem var(--serif);background:rgba(247,241,235,.96);border-radius:999px;opacity:0;transform:translateY(8px);transition:opacity .5s,transform .5s}
.strip figure:hover figcaption{opacity:1;transform:none}
@keyframes film{to{transform:translateX(-50%)}}

/* closing call to action: photo and text side by side, nothing on top of the photo */
.cta-split{display:grid;grid-template-columns:1.1fr .9fr;background:var(--alt);padding:0;overflow:hidden}
.cta-split .cta-pic{position:relative;overflow:hidden;min-height:clamp(380px,40vw,560px)}
.cta-split .cta-pic img{position:absolute;left:0;right:0;top:-12%;width:100%;height:124%;object-fit:cover}
.cta-split .cta-text{display:flex;flex-direction:column;justify-content:center;padding:clamp(40px,6vw,96px)}
.cta-split h2{max-width:14ch;margin-bottom:16px}
.cta-split p{color:var(--muted);margin-bottom:28px;max-width:42ch}

/* contact + footer */
.contact-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:clamp(30px,6vw,96px)}
.contact-info a{text-decoration:none;border-bottom:1px solid var(--line)}
.contact-info a:hover{border-color:var(--accent)}
.contact-info p{margin-bottom:.5em}
.socials{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}
.socials a{border:1px solid var(--line);border-radius:999px;padding:.5em 1.1em;font-size:.92rem;text-decoration:none;transition:background .3s,color .3s}
.socials a:hover{background:var(--ink);color:#F7F1EB}
form{display:grid;gap:16px}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
label{display:grid;gap:6px;font-size:.92rem;color:var(--muted)}
input,select,textarea{font:inherit;color:var(--text);background:var(--card);border:1px solid var(--line);border-radius:2px;padding:.85em 1em;width:100%;transition:border-color .3s}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--accent)}
textarea{min-height:130px;resize:vertical}
.thanks{display:none;padding:22px;border:1px solid var(--accent);background:var(--card)}
.thanks.show{display:block;animation:fadeup .6s both}
footer{background:var(--alt);padding:60px 0 40px;border-top:1px solid var(--line)}
.foot-grid{display:grid;grid-template-columns:1.2fr 1fr 1.2fr;gap:36px}
.foot-grid h4{font-size:1.15rem;margin-bottom:12px}
.foot-grid ul{list-style:none;margin:0;padding:0;display:grid;gap:6px}
.foot-grid a{text-decoration:none}
.foot-grid a:hover{text-decoration:underline}
.foot-logo{width:160px;height:160px;margin-bottom:18px}
.sub{display:flex;gap:8px}
.sub input{flex:1}
.fab{position:fixed;right:20px;bottom:20px;z-index:60;display:grid;place-items:center;width:58px;height:58px;border-radius:50%;background:var(--ink);color:#F7F1EB;text-decoration:none;box-shadow:0 10px 30px rgba(0,0,0,.22);transform:translateY(140%) scale(.8);transition:transform .5s cubic-bezier(.2,.7,.2,1),background .3s}
.fab:hover{background:var(--accent)}
.fab.show{transform:none}
.fab svg{width:26px;height:26px}
.mbar{display:none}
.mbar .msg{width:50px;height:50px;padding:0;flex:none}
.mbar .msg svg{width:22px;height:22px}

@media (max-width:980px){
  :root{--hh:78px}
  .wm b{font-size:1.1rem;letter-spacing:.26em}
  .wm i{font-size:.56rem;letter-spacing:.34em}
  .menu-btn{display:inline-block}
  .nav{position:absolute;left:0;right:0;top:100%;flex-direction:column;align-items:stretch;gap:0;background:var(--alt);color:var(--text);padding:12px 4vw 20px;border-bottom:1px solid var(--line);display:none}
  .nav.open{display:flex}
  .nav .btn{margin:10px 0 0}
  .contact-grid,.foot-grid,.row2,.hero,.cta-split{grid-template-columns:1fr}
  .hero-media{order:-1;min-height:58vh}
  .hero-body{padding:34px 4vw 44px}
  .fab{display:none}
  .mbar{display:grid;grid-template-columns:auto 1fr;gap:10px;position:fixed;left:0;right:0;bottom:0;z-index:60;background:var(--bg);padding:10px 4vw calc(10px + env(safe-area-inset-bottom,0px));border-top:1px solid var(--line)}
  footer{padding-bottom:110px}
}
@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}
}

/* home hero: text over the photo */
.hero.over{display:block;position:relative;min-height:calc(100svh - var(--hh));color:#fff;background:#3a302a}
.hero.over .hero-media{position:absolute;inset:0;min-height:0;order:0}
.hero.over::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(20,15,12,.46),rgba(20,15,12,0) 48%);pointer-events:none;z-index:1}
.hero.over .hero-body{position:relative;z-index:2;min-height:calc(100svh - var(--hh));justify-content:flex-end;width:min(1240px,92vw);margin-inline:auto;padding:clamp(40px,8vh,90px) 0 clamp(36px,8vh,84px)}
.hero.over h1,.hero.over .rolling{text-shadow:0 2px 24px rgba(0,0,0,.5)}
.hero.over .rolling{color:#fff}
.hero.over h1{max-width:13ch;font-size:clamp(2.7rem,6.2vw,5.4rem)}
.hero.over.short,.hero.over.short .hero-body{min-height:78svh}
.hero.over.short h1{font-size:clamp(2.6rem,5.8vw,5rem)}

.cta-split .btn{text-align:center;line-height:1.25}
/* hero: headline and rolling text centred, like the new home page */
.hero.over .hero-body{justify-content:center;align-items:center;text-align:center}
.hero.over h1{max-width:none;text-align:center}
.hero.over .rolling{text-align:center;width:100%;margin:18px 0 0}
.hero.over .rolling li{text-align:center}
/* images sliding in from each side */
.anim .slide-l{opacity:0;transform:translateX(-90px)}
.anim .slide-r{opacity:0;transform:translateX(90px)}
.anim .slide-l.in,.anim .slide-r.in{opacity:1;transform:none;transition:opacity 1s ease,transform 1.2s cubic-bezier(.2,.7,.2,1)}
/* WhatsApp */
.fab.wa{background:#25D366;color:#fff}
.fab.wa:hover{background:#1FB957}
.contact-info a.wa-btn{display:inline-flex;align-items:center;gap:10px;border:1px solid var(--ink);border-radius:999px;padding:.6em 1.25em;font-size:.95rem;transition:background .3s,color .3s,border-color .3s}
.contact-info a.wa-btn svg{width:20px;height:20px;color:var(--ink)}
.contact-info a.wa-btn:hover{background:var(--ink);border-color:var(--ink);color:#F7F1EB}
.contact-info a.wa-btn:hover svg{color:#F7F1EB}
.mbar .msg.wa{background:#25D366;border-color:#25D366;color:#fff}

/* phones: no scroll-drift, so circles and step text never overlap */
@media (max-width:900px){
  [data-speed]{transform:none!important}
  .cta-split .cta-pic img{top:0;height:100%}
}

/* ordinary online chat box (replaces the floating WhatsApp button) */
.fab.chat{background:var(--ink);color:#F7F1EB;border:0;cursor:pointer;padding:0}
.fab.chat:hover{background:var(--accent)}
.chat-panel{position:fixed;right:20px;bottom:92px;z-index:70;width:min(340px,calc(100vw - 32px));background:var(--bg);border:1px solid var(--line);border-radius:18px;box-shadow:0 20px 50px rgba(0,0,0,.22);overflow:hidden;transform-origin:bottom right;animation:chatin .35s cubic-bezier(.2,.7,.2,1) both}
.chat-panel[hidden]{display:none}
@keyframes chatin{from{opacity:0;transform:translateY(12px) scale(.96)}to{opacity:1;transform:none}}
.chat-head{display:flex;justify-content:space-between;align-items:center;background:var(--ink);color:#F7F1EB;padding:14px 16px}
.chat-head b{font:400 1.1rem var(--serif)}
.chat-head button{background:none;border:0;color:inherit;font-size:1.6rem;line-height:1;cursor:pointer;padding:0 4px}
.chat-body{padding:16px}
.chat-msg{background:var(--card);border:1px solid var(--line);border-radius:14px 14px 14px 4px;padding:.7em 1em;font-size:.95rem;max-width:90%}
.chat-form{display:grid;gap:10px;padding:0 16px 16px}
.chat-form input,.chat-form textarea{border-radius:10px;padding:.7em .9em;font-size:.95rem}
.chat-form textarea{min-height:72px}
.chat-form .btn{justify-content:center}
.chat-thanks{display:none;padding:0 16px 22px;font-size:.95rem}
@media (max-width:980px){.chat-panel{bottom:calc(88px + env(safe-area-inset-bottom,0px));right:16px}}
/* extras tick boxes in the enquiry form */
.extras-pick{border:0;margin:0;padding:0;display:grid;gap:10px}
.extras-pick legend{font-size:.92rem;color:var(--muted);padding:0;margin-bottom:8px}
.chk{display:flex;align-items:center;gap:12px;font-size:1rem;color:var(--text);cursor:pointer}
.chk input{width:20px;height:20px;padding:0;accent-color:var(--ink);flex:none}



/* ---- about page ---- */
.sec-head{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,5vw,80px);align-items:end;margin-bottom:clamp(36px,5vw,64px)}
.sec-head p{margin:0}
@keyframes spin{to{transform:rotate(360deg)}}

/* story: text beside the team photo */
.intro-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:clamp(36px,6vw,100px);align-items:center}
.intro-text h2{margin-bottom:22px}
.intro-text p{max-width:52ch}
.intro-text .btn-row{margin-top:30px}
.intro-pics{position:relative;height:clamp(420px,46vw,620px)}
.p-a{position:absolute;right:0;top:0;width:82%;height:78%}
.p-b{position:absolute;left:0;bottom:0;width:42%;height:46%;box-shadow:0 0 0 10px var(--bg),0 0 0 11px var(--ink)}
.p-a img,.p-b img{position:absolute;inset:0}
.uni{display:flex;align-items:center;gap:14px;margin-top:26px;padding-top:22px;border-top:1px solid var(--line);color:var(--muted);font-size:.95rem}
.uni svg{width:34px;height:34px;flex:none;color:var(--accent)}

/* founders: two overlapping ring circles, one for each friend */
#founders{background:var(--alt)}
#founders .sec-head{grid-template-columns:1fr;justify-items:center;text-align:center;gap:16px}
#founders .sec-head .lede{margin-inline:auto}
.pair{display:flex;justify-content:center;align-items:center;margin:10px auto clamp(40px,5vw,64px)}
.fc{position:relative;width:clamp(230px,26vw,340px);aspect-ratio:1;flex:none;transition:transform .7s cubic-bezier(.2,.7,.2,1)}
.fc + .fc{margin-left:clamp(-70px,-5vw,-40px)}
.fc .ph{position:absolute;inset:0;border-radius:50%;overflow:hidden;background:var(--light);box-shadow:0 0 0 8px var(--alt),0 0 0 9px var(--ink)}
.fc .ph img{width:100%;height:100%;object-fit:cover;transition:transform 1.2s cubic-bezier(.2,.7,.2,1)}
.fc::after{content:"";position:absolute;inset:-22px;border-radius:50%;border:2.5px dotted var(--ink);opacity:.35;animation:spin 40s linear infinite;pointer-events:none}
.fc:nth-child(2)::after{animation-direction:reverse}
.fc:hover{transform:translateY(-8px);z-index:2}
.fc:hover .ph img{transform:scale(1.06)}
.fc:hover::after{opacity:.8}
.fc .tag{position:absolute;left:50%;bottom:-6px;transform:translateX(-50%);z-index:3;background:var(--bg);border:1px solid var(--ink);border-radius:999px;padding:.45em 1.3em;font:400 1.15rem/1 var(--serif);white-space:nowrap}
.bios{display:grid;grid-template-columns:1fr 1fr;gap:clamp(30px,6vw,90px);max-width:860px;margin:0 auto;text-align:center}
.bio h3{margin-bottom:6px}
.bio .role{display:block;color:var(--accent);margin-bottom:14px;letter-spacing:.03em}
.bio p{color:var(--muted);margin:0}
.ph-note{font-style:italic;font-size:.9rem;color:var(--muted);text-align:center;margin:28px 0 0}
/* entrance: circles open up, then slide together */
.anim .pair .fc{opacity:0}
.anim .pair .fc:first-child{transform:translateX(-60px)}
.anim .pair .fc:last-child{transform:translateX(60px)}
.anim .pair .fc .ph{clip-path:circle(0% at 50% 50%)}
.anim .pair.in .fc{opacity:1;transform:none;transition:opacity .9s,transform 1.3s cubic-bezier(.2,.7,.2,1)}
.anim .pair.in .fc .ph{clip-path:circle(75% at 50% 50%);transition:clip-path 1.3s cubic-bezier(.7,0,.2,1) .2s}
.anim .pair.in .fc:hover{transform:translateY(-8px)}

/* mission banner */
.mission{text-align:center;padding:clamp(80px,10vw,140px) 0}
.mission .house{width:64px;height:64px;margin:0 auto 26px;color:var(--accent)}
.mission blockquote{margin:0 auto;max-width:22ch;font:400 clamp(2rem,4.4vw,3.4rem)/1.2 var(--serif);color:var(--text)}
.mission .line{display:block;width:min(420px,70%);height:2px;margin:34px auto 0;background:radial-gradient(circle,var(--ink) 1.2px,transparent 1.6px) 0 50%/12px 2px repeat-x;animation:dots 1.6s linear infinite}
@keyframes dots{to{background-position:12px 50%}}

/* what we believe */
#approach{border-top:1px solid var(--line)}
.beliefs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(28px,4vw,60px)}
.belief{text-align:center}
.belief .bd{position:relative;width:clamp(150px,15vw,190px);aspect-ratio:1;margin:0 auto 30px}
.belief .bd .ph{position:absolute;inset:0;border-radius:50%;overflow:hidden;background:var(--light);box-shadow:0 0 0 7px var(--bg),0 0 0 8px var(--line);transition:box-shadow .4s}
.belief .bd img{width:100%;height:100%;object-fit:cover;transition:transform 1.2s cubic-bezier(.2,.7,.2,1)}
.belief .bd::after{content:"";position:absolute;inset:-16px;border-radius:50%;border:2.5px dotted var(--ink);opacity:0;transition:opacity .5s}
.belief:hover .bd .ph{box-shadow:0 0 0 7px var(--bg),0 0 0 8px var(--ink)}
.belief:hover .bd img{transform:scale(1.07)}
.belief:hover .bd::after{opacity:.55;animation:spin 14s linear infinite}
.belief h3{font-size:clamp(1.35rem,2vw,1.7rem);margin-bottom:12px}
.belief p{color:var(--muted);max-width:32ch;margin:0 auto}

@media (max-width:980px){
  .sec-head,.intro-grid,.bios,.beliefs{grid-template-columns:1fr}
  .intro-pics{height:clamp(340px,80vw,520px)}
  .bios{text-align:center;max-width:560px}
}
@media (max-width:640px){
  .fc{width:clamp(150px,44vw,190px)}
  .fc + .fc{margin-left:-28px}
  .fc::after{inset:-12px}
  .fc .ph{box-shadow:0 0 0 5px var(--alt),0 0 0 6px var(--ink)}
  .fc .tag{font-size:.95rem;padding:.4em 1em}
  .belief .bd{width:150px}
